{
  "name": "@pimbay/search-query",
  "version": "0.0.0",
  "description": "Framework-agnostic, strict search/pagination contracts (page, slice, cursor) with no runtime magic — a foundation for datasource-specific extensions, starting with Drizzle.",
  "keywords": [
    "pagination",
    "search-terms",
    "typescript",
    "cursor",
    "adapter"
  ],
  "license": "Unlicense",
  "author": {
    "name": "Jan Sarmir",
    "email": "sarmir@pimbay.dev",
    "url": "https://pimbay.dev"
  },
  "homepage": "https://pimbay.dev",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/pimbay-js/search-query"
  },
  "bugs": {
    "url": "https://github.com/pimbay-js/search-query/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit:prod": "npm audit --omit=dev",
    "js:build": "tsc -p tsconfig.build.json",
    "js:format": "prettier --check .",
    "js:format:fix": "prettier --write .",
    "js:lint": "eslint src test",
    "js:lint:fix": "eslint src test --fix",
    "js:typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run js:build",
    "test:22": "docker compose run --rm node22 sh -c 'npm install && npm run js:build && npm run test:unit'",
    "test:24": "docker compose run --rm node24 sh -c 'npm install && npm run js:build && npm run test:unit'",
    "test:26": "docker compose run --rm node26 sh -c 'npm install && npm run js:build && npm run test:unit'",
    "test:all": "npm run test:22 && npm run test:24 && npm run test:26",
    "test:coverage": "vitest run --coverage test/unit",
    "test:mutation": "stryker run",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
